node_modules/
package-lock.json
dist/
data/backups/

# Автогенерится `npm run lint:refresh-globals` — см. eslint.config.mjs
.eslint-window-globals.json

# Playwright screenshots в корне (сохраняются MCP-агентом во время отладки)
/*.png
/*.jpeg

# Секреты (GitHub PAT и т.п.) — никогда не коммитить
.env
.env.*
!.env.example

# Локальная конфигурация MCP-серверов (у каждого разработчика своя)
.mcp.json
.playwright-mcp/

# macOS
.DS_Store
**/.DS_Store

# Тяжёлые ассеты (JPG) — скачиваются через assets/download.sh, не хранятся в git
assets/portraits/**/*.jpg
assets/textures/*.jpg
assets/backgrounds/*.jpg

# Тактическая битва (Track B): terrain-тайлы и raw-паки — через
# assets/battle/download_battle_assets.sh. SVG-иконки в units/ и objects/
# коммитим как обычный код (маленькие, CC-BY 3.0, атрибуция в README).
assets/battle/terrain/*.jpg
assets/battle/terrain/*.jpeg
assets/battle/terrain/*.png
assets/battle/terrain/*.webp
assets/battle/raw/**
docs/battle_ui/refs/*.jpg
docs/battle_ui/refs/*.jpeg
docs/battle_ui/refs/*.png
docs/battle_ui/refs/*.gif
docs/battle_ui/refs/*.webp
docs/battle_ui/refs/*.mp4

# Локальные AI модели (большие файлы, не коммитить)
models/
*.gguf
llm_server.log
llm_server.pid
llm_model.path

# Результаты стресс-прогонов экономики (NDJSON-логи + stdout + markdown-отчёты).
# Регенерируются через `npm run eco:stress` / `eco:report`. NDJSON-файлы
# одного 100-ходового прогона ~100 МБ, 500-ходового — 500+ МБ, в git не место.
# Markdown-отчёты (*_report.md) — мелкие, полезные как снимки состояния по этапам,
# их коммитим.
perf/*.ndjson
perf/*.ndjson.meta.json
perf/*.log
perf/eco_report.md

# Локальный lock планировщика Claude Code
.claude/scheduled_tasks.lock
